# DevFlow configuration template.
#
# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. DevFlow reads these at runtime; a real environment variable of the
# same name always takes precedence over this file.
#
# Without these, DevFlow still runs: finding prioritization falls back to
# deterministic severity/evidence ordering and says so.

# --- IBM watsonx.ai (finding prioritization) -------------------------------

# IBM Cloud API key, created from the watsonx.ai Developer access page.
DEVFLOW_WATSONX_APIKEY=

# Project ID from the watsonx.ai "Project or deployment space" selector.
DEVFLOW_WATSONX_PROJECT_ID=

# Regional watsonx.ai endpoint. Dallas is the hackathon-provisioned region.
DEVFLOW_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Optional. Defaults to a Granite instruct model.
# Do not set this to llama-3-405b-instruct, mistral-medium-2505, or
# mistral-small-3-1-24b-instruct-2503: those are out of scope for the
# IBM TechXchange 2026 hackathon and DevFlow refuses to call them.
# DEVFLOW_WATSONX_MODEL=ibm/granite-3-3-8b-instruct

# Optional. Record and replay watsonx responses so a demo never depends on a
# live network call. Delete the file to force a fresh call.
# DEVFLOW_WATSONX_CACHE=.devflow/watsonx-cache.json

# Optional. Seconds to wait for IBM Cloud before falling back. Default 30.
# DEVFLOW_WATSONX_TIMEOUT=30

# Optional. Set to 1 to force deterministic prioritization.
# DEVFLOW_WATSONX_DISABLE=0

# --- DevFlow ---------------------------------------------------------------

# DEVFLOW_LOG_LEVEL=INFO
